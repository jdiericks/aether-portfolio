{
  "mcpServers": {
    "real-estate-admin": {
      "command": "npx",
      "args": ["tsx", "mcp/stdio.ts"],
      "env": {
        "DATABASE_URL": "${DATABASE_URL}",
        "BLOB_READ_WRITE_TOKEN": "${BLOB_READ_WRITE_TOKEN}"
      }
    },
    "real-estate-admin-remote": {
      "url": "${MCP_BASE_URL:-http://localhost:3000}/api/mcp",
      "headers": {
        "Authorization": "Bearer ${MCP_ACCESS_TOKEN}"
      }
    }
  }
}
