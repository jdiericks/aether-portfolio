DATABASE_URL="postgresql://user:password@host:5432/database?sslmode=require"

# Required in production for NextAuth session/JWT signing.
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"

# Used by npm run db:seed:admin to create or update the admin login.
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD=""
ADMIN_NAME="Admin"

# Optional: separate secret for protected property-package cookies.
# If omitted, NEXTAUTH_SECRET is used.
GALLERY_COOKIE_SECRET=""

# Required for uploading listing/package media to Vercel Blob.
# Vercel Blob store: real-estate-mcp-blob
BLOB_READ_WRITE_TOKEN=""

# Resend transactional email. Without this, emails are logged to the server
# console instead of sent. From address must be on a verified Resend domain.
RESEND_API_KEY=""
EMAIL_FROM="no-reply@example.com"

# Optional MCP OAuth static client config.
MCP_BASE_URL="http://localhost:3000"
MCP_OAUTH_CLIENT_ID=""
MCP_OAUTH_CLIENT_SECRET=""

# Optional Meta/Facebook/Instagram OAuth integration.
# Configure a Meta app with this callback URL:
#   https://your-domain.com/api/meta/callback
META_APP_ID=""
META_APP_SECRET=""
META_REDIRECT_URI="http://localhost:3000/api/meta/callback"

# Optional Google Search Console API integration for MCP SEO reports.
# Add the service account email as a user on the Search Console property.
GOOGLE_SEARCH_CONSOLE_SITE_URL="https://your-domain.com/"
GOOGLE_SERVICE_ACCOUNT_EMAIL=""
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=""
# Alternatively provide the full service account JSON in one variable.
GOOGLE_SERVICE_ACCOUNT_JSON=""
